#!/usr/bin/env bun

import { basename, resolve } from "node:path";

const usage = `usage:
  forward-port [port] [project-name]
  forward-port --file <html-file> [project-name]`;

function fail(message, code = 1) {
  console.error(`forward-port: ${message}`);
  process.exit(code);
}

function slugify(value) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const args = process.argv.slice(2);
if (args.includes("-h") || args.includes("--help")) {
  console.log(usage);
  process.exit(0);
}

let filePath;
let port = 3000;
let projectName;

if (args[0] === "--file") {
  if (args.length < 2 || args.length > 3) fail(usage, 2);
  filePath = resolve(args[1]);
  projectName = args[2];
  if (!(await Bun.file(filePath).exists())) fail(`missing ${filePath}`);
} else {
  if (args.length > 2) fail(usage, 2);
  const portText = args[0] ?? "3000";
  if (!/^\d+$/.test(portText) || Number(portText) < 1 || Number(portText) > 65535) {
    fail(`invalid port '${portText}'`, 2);
  }
  port = Number(portText);
  projectName = args[1];
}

const slug = slugify(projectName ?? basename(process.cwd()));
if (!slug) fail(`project name '${projectName}' does not produce a usable slug`, 2);
if (!Bun.which("cloudflared")) fail("cloudflared is not installed", 127);

let server;
if (filePath) {
  server = Bun.serve({
    hostname: "localhost",
    port: 0,
    fetch(request) {
      const pathname = new URL(request.url).pathname;
      if (pathname !== "/" && pathname !== "/index.html") {
        return new Response("Not found", { status: 404 });
      }
      return new Response(Bun.file(filePath), {
        headers: { "content-type": "text/html; charset=utf-8" },
      });
    },
  });
  port = server.port;
}

const origin = `http://localhost:${port}`;
console.error(`forward-port: forwarding ${origin} as ${slug}`);

const tunnel = Bun.spawn(["cloudflared", "tunnel", "--url", origin], {
  stdin: "inherit",
  stdout: "pipe",
  stderr: "pipe",
});

function stop(signal) {
  server?.stop(true);
  tunnel.kill(signal);
}

process.once("SIGINT", () => stop(2));
process.once("SIGTERM", () => stop(15));
process.once("SIGHUP", () => stop(1));

let announced = false;
async function handleLine(line) {
  if (!line) return;
  console.error(line);
  if (announced) return;

  const match = line.match(/https:\/\/[A-Za-z0-9-]+\.trycloudflare\.com/);
  if (!match) return;

  announced = true;
  const quickUrl = match[0];
  console.log(`quick_url=${quickUrl}`);

  const registerUrl = process.env.TRYCF_REGISTER_URL;
  if (!registerUrl) return;

  const devBase = (process.env.TRYCF_DEV_BASE ?? "https://dev.hsichen.dev").replace(/\/+$/, "");
  const headers = { "content-type": "application/json" };
  const token = process.env.TRYCF_REGISTER_TOKEN;
  if (token) headers.authorization = `Bearer ${token}`;

  try {
    const response = await fetch(registerUrl, {
      method: "POST",
      headers,
      body: JSON.stringify({ project: slug, target: quickUrl, origin }),
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    console.log(`dev_url=${devBase}/${slug}`);
  } catch (error) {
    console.error(`forward-port: stable alias registration failed: ${error.message}`);
  }
}

async function relay(stream) {
  const reader = stream.getReader();
  const decoder = new TextDecoder();
  let buffer = "";

  while (true) {
    const { done, value } = await reader.read();
    buffer += decoder.decode(value, { stream: !done });
    const lines = buffer.split(/\r?\n/);
    buffer = done ? "" : lines.pop();
    for (const line of lines) await handleLine(line);
    if (done) {
      await handleLine(buffer);
      return;
    }
  }
}

const [exitCode] = await Promise.all([
  tunnel.exited,
  relay(tunnel.stdout),
  relay(tunnel.stderr),
]);
server?.stop(true);
process.exit(exitCode);
